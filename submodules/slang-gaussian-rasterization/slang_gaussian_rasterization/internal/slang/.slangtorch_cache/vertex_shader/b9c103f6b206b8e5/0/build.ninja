ninja_required_version = 1.3
cxx = /data/conda/envs/LOD/bin/x86_64-conda-linux-gnu-c++
nvcc = /data/conda/envs/LOD/targets/x86_64-linux/bin/nvcc

cflags = -DTORCH_EXTENSION_NAME=_slangtorch_vertex_shader_b9c103f6b206b8e5 -DTORCH_API_INCLUDE_EXTENSION_H -DPYBIND11_COMPILER_TYPE=\"_gcc\" -DPYBIND11_STDLIB=\"_libstdcpp\" -DPYBIND11_BUILD_ABI=\"_cxxabi1018\" -I/data/fwindisch/hierarchical-LOD-gaussians/submodules/slang-gaussian-rasterization/slang_gaussian_rasterization/internal/slang -isystem /data/conda/envs/LOD/lib/python3.10/site-packages/torch/include -isystem /data/conda/envs/LOD/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -isystem /data/conda/envs/LOD/targets/x86_64-linux/include -isystem /data/conda/envs/LOD/include/python3.10 -fPIC -std=c++17 -std=c++17
post_cflags = 
cuda_cflags = -ccbin /data/conda/envs/LOD/bin/x86_64-conda-linux-gnu-cc -DTORCH_EXTENSION_NAME=_slangtorch_vertex_shader_b9c103f6b206b8e5 -DTORCH_API_INCLUDE_EXTENSION_H -DPYBIND11_COMPILER_TYPE=\"_gcc\" -DPYBIND11_STDLIB=\"_libstdcpp\" -DPYBIND11_BUILD_ABI=\"_cxxabi1018\" -I/data/fwindisch/hierarchical-LOD-gaussians/submodules/slang-gaussian-rasterization/slang_gaussian_rasterization/internal/slang -isystem /data/conda/envs/LOD/lib/python3.10/site-packages/torch/include -isystem /data/conda/envs/LOD/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -isystem /data/conda/envs/LOD/targets/x86_64-linux/include -isystem /data/conda/envs/LOD/include/python3.10 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr -gencode=arch=compute_90,code=compute_90 -gencode=arch=compute_90,code=sm_90 --compiler-options '-fPIC' -std=c++17 --use_fast_math --generate-line-info -U__CUDA_NO_HALF_OPERATORS__ -U__CUDA_NO_HALF_CONVERSIONS__ -U__CUDA_NO_HALF2_OPERATORS__ -U__CUDA_NO_BFLOAT16_CONVERSIONS__ -DSLANG_CUDA_ENABLE_HALF=1
cuda_post_cflags = 
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = -shared -L/data/conda/envs/LOD/lib/python3.10/site-packages/torch/lib -lc10 -lc10_cuda -ltorch_cpu -ltorch_cuda -ltorch -ltorch_python -L/data/conda/envs/LOD/targets/x86_64-linux/lib -lcudart

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





rule link
  command = $cxx $in $ldflags -o $out

build vertex_shader.o: compile /data/fwindisch/hierarchical-LOD-gaussians/submodules/slang-gaussian-rasterization/slang_gaussian_rasterization/internal/slang/.slangtorch_cache/vertex_shader/b9c103f6b206b8e5/vertex_shader.cpp
build vertex_shader_cuda.cuda.o: cuda_compile /data/fwindisch/hierarchical-LOD-gaussians/submodules/slang-gaussian-rasterization/slang_gaussian_rasterization/internal/slang/.slangtorch_cache/vertex_shader/b9c103f6b206b8e5/vertex_shader_cuda.cu





build _slangtorch_vertex_shader_b9c103f6b206b8e5.so: link vertex_shader.o vertex_shader_cuda.cuda.o

default _slangtorch_vertex_shader_b9c103f6b206b8e5.so
